{
  "expo": {
    "name": "Ina Igar",
    "slug": "hackathon-demo",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "xyz.j4an.isdhack",
      "infoPlist": {
        "CFBundleDisplayName": "Ina Igar",
        "NSCameraUsageDescription": "La app usa la cámara para leer tus documentos en el teléfono. Las fotos no salen del dispositivo.",
        "NSPhotoLibraryUsageDescription": "Para elegir una foto de un documento. No se sube a ningún servidor.",
        "NSMicrophoneUsageDescription": "Permiso pedido por el SDK de cámara. La demo no graba audio.",
        "NSLocalNetworkUsageDescription": "Para enviar la solicitud de crédito al nodo del pueblo, sin internet.",
        "NSBonjourServices": [
          "_expo._tcp",
          "_metro._tcp",
          "_http._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#186730"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "xyz.j4an.isdhack",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "0xj4an",
          "project": "isd-hackathon-mobile"
        }
      ],
      "@qvac/sdk/expo-plugin",
      "./plugins/withQvacBareLink",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 29,
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "La app usa la cámara para leer tus documentos en el teléfono. Las fotos no salen del dispositivo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Para elegir una foto de un documento. No se sube a ningún servidor."
        }
      ],
      "expo-document-picker",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "7c9b3106-b2eb-43ff-9635-3af2e9cef778"
      }
    },
    "owner": "tbd-panama"
  }
}

{
  "name": "@app/nodo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nodo del corregimiento + banco mock. Recibe solicitudes JSON por Hyperswarm (P2P) o HTTP local y responde con una decisión de crédito tomada por el motor de mobile/src/core/credito/.",
  "scripts": {
    "start": "ROL=banco PORT=8787 node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON index.mjs",
    "banco": "ROL=banco PORT=8787 node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON index.mjs",
    "corregimiento": "ROL=corregimiento PORT=8788 BANCO_URL=https://banco-production-3755.up.railway.app node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON index.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "b4a": "^1.6.7",
    "hypercore-crypto": "^3.4.2",
    "hyperswarm": "^4.8.0",
    "zod": "^4.5.4"
  }
}

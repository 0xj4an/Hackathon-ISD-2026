{
  "name": "@app/nodo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pueblo (LAN :8788, y /inferir si el teléfono no carga MedPsy) y banco. El motor vive en mobile/src/core/credito/. HTTP es el transporte de la demo.",
  "scripts": {
    "start": "ROL=banco PORT=8787 node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON index.mjs",
    "banco": "ROL=banco PORT=8787 node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON index.mjs",
    "corregimiento": "ROL=corregimiento PORT=8788 BANCO_URL=https://banco-production-3755.up.railway.app node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON index.mjs",
    "p2p:bootstrap": "node bootstrap-dht.mjs",
    "p2p:probe": "node probe-p2p.mjs",
    "p2p:probar": "node probar-p2p.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "b4a": "^1.6.7",
    "blind-relay": "^1.6.1",
    "bonjour-service": "^1.4.4",
    "hypercore-crypto": "^3.4.2",
    "hyperdht": "^6.34.0",
    "hyperswarm": "^4.8.0",
    "zod": "^4.5.4"
  }
}
